# Copy to .env (git-ignored). Leave a provider's setting empty to switch it off.
ROUTES_FILE=routes.yaml
REQUEST_TIMEOUT_S=30
GEMINI_API_KEY=
# e.g. us-east-1. Credentials come from the AWS chain (aws configure / an IAM role), never from here.
BEDROCK_REGION=
# e.g. http://localhost:11434
OLLAMA_URL=
ENABLE_FAKE=true
