# Copy to .env (git-ignored). Leave a provider's setting empty to switch it off.
# SQLite works for local development; use Postgres anywhere real:
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gateway
DATABASE_URL=sqlite+aiosqlite:///gateway.db
ROUTES_FILE=routes.yaml
PRICES_FILE=prices.yaml
GEMINI_API_KEY=
# e.g. us-east-1. Credentials come from the AWS chain (aws configure / an IAM role), never from here.
BEDROCK_REGION=
# e.g. http://localhost:11434
OLLAMA_URL=
ENABLE_FAKE=true
FLAKY_FAILURE_RATE=0.5
# Resilience: timeouts and cooldown in seconds
REQUEST_TIMEOUT_S=30
TOTAL_TIMEOUT_S=60
ATTEMPTS_PER_TARGET=2
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_S=30
